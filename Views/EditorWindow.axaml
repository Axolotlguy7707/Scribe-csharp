<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="Scribe.Views.EditorWindow"
        Title="Scribe - Book Editor"
        Width="900" Height="600"
        Icon="/Assets/icon.ico">

    <Grid RowDefinitions="Auto,*">

        <!-- Top Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="New Book"/>
                <MenuItem Header="Open Book" Click="Open_Click"/>
                <MenuItem Header="New Chapter" Click="NewChapter_Click"/>
                <MenuItem Header="Save" Click="Save_Click"/>
                <MenuItem Header="Export">
                    <MenuItem Header="PDF"/>
                    <MenuItem Header="EPUB"/>
                    <MenuItem Header="TXT"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Edit">
                <MenuItem Header="Undo"/>
                <MenuItem Header="Redo"/>
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Zoom In"/>
                <MenuItem Header="Zoom Out"/>
            </MenuItem>

            <MenuItem Header="Window">
                <MenuItem Header="Minimize"/>
                <MenuItem Header="Maximize"/>
            </MenuItem>

            <MenuItem Header="Chapters" x:Name="ChaptersMenu"/>
        </Menu>

        <!-- Fixed-size editor -->
        <Border Grid.Row="1"
                Width="700"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4">

            <AvaloniaEdit:TextEditor Name="Editor"
                                     FontFamily="Cascadia Code, Consolas, Monospace"
                                     FontSize="16"
                                     WordWrap="True"
                                     HorizontalScrollBarVisibility="Visible"
                                     VerticalScrollBarVisibility="Visible"
                                     IsReadOnly="False"
                                     IsEnabled="True"/>
        </Border>

    </Grid>
</Window>
